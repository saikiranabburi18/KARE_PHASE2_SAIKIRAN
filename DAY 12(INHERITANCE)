class Father
{
    void gen2(){
        System.out.println("Gold");
    }
}
class Son extends Father{
    void gen3(){
        System.out.println("Diamond");
    }
}
class Main{
    public static void main(String args[]){
        Son s=new Son();
        Father f=new Father();
        f.gen2();
       // f.gen3(); not accessible
        s.gen2();
        s.gen3();
    }
} 


class GrandFather{
    void gen1(){
        System.out.println("Cash/Money");
    }
}

class Father extends GrandFather
{
    void gen2(){
        System.out.println("Gold");
    }
}
class Son extends Father{
    void gen3(){
        System.out.println("Diamond");
    }
}
class Main{
    public static void main(String args[]){
        Son s=new Son();
        Father f=new Father();
        GrandFather GF=new GrandFather();
        GF.gen1();
        f.gen2();
        s.gen1();
        s.gen2();
        s.gen3();
    }
} 
// 1) Single Inheritance

class Animal
{
    void eat(){
        System.out.println("Eating");
    }
}

class Dog extends Animal
{
    void bark(){
        System.out.println("Barking");
    }
}

class Main
{
    public static void main(String args[]){
        Dog d = new Dog();
        d.eat();
        d.bark();
    }
}

// Output:
// Eating
// Barking


// 2) Multilevel Inheritance

class GrandFather
{
    void money(){
        System.out.println("Money");
    }
}

class Father extends GrandFather
{
    void house(){
        System.out.println("House");
    }
}

class Son extends Father
{
    void bike(){
        System.out.println("Bike");
    }
}

class Main
{
    public static void main(String args[]){
        Son s = new Son();
        s.money();
        s.house();
        s.bike();
    }
}

// Output:
// Money
// House
// Bike


// 3) Hierarchical Inheritance

class Parent
{
    void property(){
        System.out.println("Property");
    }
}

class Son extends Parent
{
    void car(){
        System.out.println("Car");
    }
}

class Daughter extends Parent
{
    void gold(){
        System.out.println("Gold");
    }
}

class Main
{
    public static void main(String args[]){
        Son s = new Son();
        Daughter d = new Daughter();

        s.property();
        s.car();

        d.property();
        d.gold();
    }
}

// Output:
// Property
// Car
// Property
// Gold


