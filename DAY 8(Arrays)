// FIND THE ELEMENT IN THE ARRAY
// Input:
// 5
// 10 20 30 40 50
// 30
// Output:
// Element found

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int search = sc.nextInt();
        boolean found = false;

        for(int i = 0; i < n; i++) {
            if(arr[i] == search) {
                found = true;
                break;
            }
        }

        if(found) {
            System.out.println("Element found");
        } else {
            System.out.println("Element not found");
        }
    }
}


// 4) COUNT POSITIVE AND NEGATIVE ELEMENTS
// Input:
// 5
// 10 -20 30 -40 50
// Output:
// Positive elements count = 3
// Negative elements count = 2

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int positive = 0, negative = 0;
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();

            if(arr[i] > 0) {
                positive++;
            } else if(arr[i] < 0) {
                negative++;
            }
        }

        System.out.println("Positive elements count = " + positive);
        System.out.println("Negative elements count = " + negative);
    }
}


// FIND THE SECOND LARGEST ELEMENT
// Input:
// 5
// 10 50 30 40 20
// Output:
// Second largest = 40

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int largest = arr[0];
        int second = arr[0];

        for(int i = 1; i < n; i++) {
            if(arr[i] > largest) {
                second = largest;
                largest = arr[i];
            } else if(arr[i] > second && arr[i] != largest) {
                second = arr[i];
            }
        }

        System.out.println("Second largest = " + second);
    }
}
