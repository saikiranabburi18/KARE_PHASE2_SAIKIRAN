// FIND THE LARGEST ELEMENT IN THE ARRAY
// Input:
// 5
// 13 34 54 67 22
// Output:
// Largest element = 67

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int max = arr[0];

        for(int i = 1; i < n; i++) {
            if(arr[i] > max) {
                max = arr[i];
            }
        }

        System.out.println("Largest element = " + max);
    }
}


