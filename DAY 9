// 1) FIND THE FREQUENCY OF A GIVEN ELEMENT
// Input:
// 6
// 10 20 10 30 10 40
// 10
// Output:
// Frequency = 3

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int search = sc.nextInt();
        int count = 0;

        for(int i = 0; i < n; i++) {
            if(arr[i] == search) {
                count++;
            }
        }

        System.out.println("Frequency = " + count);
    }
}


// 2) FIND THE FIRST AND LAST OCCURRENCE
// Input:
// 7
// 10 20 30 20 40 20 50
// 20
// Output:
// First occurrence = 1
// Last occurrence = 5

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int search = sc.nextInt();
        int first = -1;
        int last = -1;

        for(int i = 0; i < n; i++) {
            if(arr[i] == search) {
                if(first == -1) {
                    first = i;
                }
                last = i;
            }
        }

        System.out.println("First occurrence = " + first);
        System.out.println("Last occurrence = " + last);
    }
}


// 3) MOVE ALL ZEROES TO THE END
// Input:
// 6
// 0 1 0 3 12 0
// Output:
// 1 3 12 0 0 0

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int index = 0;

        for(int i = 0; i < n; i++) {
            if(arr[i] != 0) {
                arr[index] = arr[i];
                index++;
            }
        }

        while(index < n) {
            arr[index] = 0;
            index++;
        }

        for(int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}


// 4) FIND THE SUM OF EVEN AND ODD ELEMENTS
// Input:
// 5
// 10 15 20 25 30
// Output:
// Even Sum = 60
// Odd Sum = 40

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];
        int evenSum = 0;
        int oddSum = 0;

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();

            if(arr[i] % 2 == 0) {
                evenSum = evenSum + arr[i];
            } else {
                oddSum = oddSum + arr[i];
            }
        }

        System.out.println("Even Sum = " + evenSum);
        System.out.println("Odd Sum = " + oddSum);
    }
}


// 5) LEFT ROTATE ARRAY BY ONE POSITION
// Input:
// 5
// 10 20 30 40 50
// Output:
// 20 30 40 50 10

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int first = arr[0];

        for(int i = 0; i < n - 1; i++) {
            arr[i] = arr[i + 1];
        }

        arr[n - 1] = first;

        for(int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}


// 6) RIGHT ROTATE ARRAY BY ONE POSITION
// Input:
// 5
// 10 20 30 40 50
// Output:
// 50 10 20 30 40

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int last = arr[n - 1];

        for(int i = n - 1; i > 0; i--) {
            arr[i] = arr[i - 1];
        }

        arr[0] = last;

        for(int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}



