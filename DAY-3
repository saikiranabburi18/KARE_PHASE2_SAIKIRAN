/* switch program */
import java.util.*;
class Main {
    public static void main (String[] args){
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        switch(n)
        
        {
            case 1:
                System.out.print("CSE");
                break;
            case 2:
                System.out.print("ECE");
                break;
            case 3:
                System.out.print("EEE");
                break;
                default:
                System.out.print("Invalid input");
        }
    }
}

