import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();

        for(int row = 0; row < n; row++) {
            for(int col = 0; col < m; col++) {
                if(row == 0 || row == n-1 || col == 0 || col == m-1)
                    System.out.print("*");
                else
                    System.out.print(" ");
            }
            System.out.println();
        }
    }
}


