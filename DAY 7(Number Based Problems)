// prime number - a number which is having only 2 factors
3
Prime NUMBER

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
	    int n1 = sc.nextInt();
	    int count=0;
	    for(int i=1;i<=n1;i++){
	       if(n1%i==0){
	           count++;
	           if(count>2){
	               break;
	           }
	        }
	    }
	    if(count==2){
	        System.out.println("Prime NUMBER");
	    }else {
	        System.out.println("NOT A Prime NUMBER");
	    }	
	}
}
