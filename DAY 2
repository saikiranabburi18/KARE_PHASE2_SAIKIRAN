/* write a java program to pre and post increment and decrement*/

import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a = sc.nextInt(); //a=29
		int b,c,d,e;
		
		 b=a++;
		 c=--b;
		 d=c++;
		 e=++d;
		 System.out.println(a + " "+ b+" "+c+" "+d+" "+e);
			
	}
}

OUTPUT:
11 12 13 14 15
12 10 11 11 11


import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = a++;
        int c = b--;
        int d = --c;
        int e = d++;
        int f = e--;
        System.out.println(f++);
        System.out.println(a+" "+b+" "+c+" "+d+" "+e+" "+f);
        
    }
}

OUTPUT:
9
11 9 9 10 8 10

