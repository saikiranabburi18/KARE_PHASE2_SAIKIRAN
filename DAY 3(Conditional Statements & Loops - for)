    }
}

//Write a program to check whether the time is valid or not using conditional construct.
//Input Format
//hh:mm:ss
import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner  sc = new Scanner(System.in);
        sc.useDelimiter("[:\\r\\n]+");
        int hour = sc.nextInt();
        int min = sc.nextInt();
        int sec = sc.nextInt();
        if(hour >= 0 && hour < 24 && min >= 0 && min <= 59 && sec >= 0 && sec <= 59){
            System.out.println("Valid");
        }else{
            System.out.println("Not Valid");
        }
    }
}

//Write a program to find given a specific date ,check whether the date is valid or not. Year will be in range 1900 to 9999
//Input Format
//dd/mm/yy
import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner sc =new Scanner(System.in);
        sc.useDelimiter("[/\\r\\n]+");
        int date = sc.nextInt();
        int month = sc.nextInt();
        int year = sc.nextInt();
        
        // Simple if-else validation
        if (date >= 1 && date < 31 && month >= 1 && month <= 12 &&month!=2 && year >= 1900 && year <= 9999) {
            System.out.println("Valid");
        } else {
            System.out.println("Invalid");
        }
        if (date >= 1 && date < 29 && month == 2 && year >= 1900 && year <= 9999){
            
            System.out.println("Valid");
        }
        else if(date >= 1 && date > 29 && month == 2 && year >= 1900 && year <= 9999){
            System.out.println("Invalid");
        }
        
    }
}
