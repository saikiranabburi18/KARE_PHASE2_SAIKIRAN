import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int start=sc.nextInt();
		int end=sc.nextInt();
		int temp=0;
		for(int i=start;i<=end;i++){
		    temp += i;
		}
		System.out.println(temp);
	}
}


