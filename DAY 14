// write a java program to find nth term of fibinocci series by using recursion
6
8


import java.util.*;
public class Main
{
    static int fib(int n){
        if(n<=1)
            return n;
            return fib(n-1)+fib(n-2);
    }
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n=sc.nextInt();
		int ans=fib(n);
		System.out.println(ans);
	}
}


